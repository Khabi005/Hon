                            ),
                            child: Center(
                              child: Text(
                                '${DatabaseService.instance.getTodayReadingMinutes()}',
                                style: const TextStyle(
                                  fontSize: 13,
                                  fontWeight: FontWeight.w700,
                                  color: HonColors.accentBlue,
                                ),
                              ),
                            ),
                          ),
                        ),
                        const SizedBox(width: 12),

