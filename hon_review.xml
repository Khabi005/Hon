<file path="lib/features/sheets/add_to_library_prompt.dart">
import 'package:flutter/material.dart';
import '../../core/database/database_service.dart';
import '../../core/models/book.dart';
import '../../app/theme/hon_colors.dart';
import '../../shared/widgets/book_cover_widget.dart';

enum AddToLibraryChoice {
  addToLibrary,
  notNow,
}

class AddToLibraryPrompt {
  static Future<AddToLibraryChoice> show(
    BuildContext context, {
    required Book novel,
  }) async {
    final db = DatabaseService.instance;

    // Rule: Recheck membership immediately before showing
    if (db.isBookInLibrary(novel.id)) {
      return AddToLibraryChoice.addToLibrary;
    }

    // Rule: If suppressed for current session, automatically proceed as Not Now
    if (db.isPromptSuppressedForSession(novel.id)) {
      return AddToLibraryChoice.notNow;
    }

    final isDark = Theme.of(context).brightness == Brightness.dark;

    final result = await showModalBottomSheet<AddToLibraryChoice>(
      context: context,
      backgroundColor: Colors.transparent,
      isScrollControlled: true,
      builder: (ctx) {
        return Container(
          decoration: BoxDecoration(
            color: isDark ? HonColors.darkSurface : HonColors.lightSurface,
            borderRadius: const BorderRadius.vertical(top: Radius.circular(24)),
          ),
          padding: const EdgeInsets.fromLTRB(24, 16, 24, 32),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              // Handle bar
              Container(
                width: 36,
                height: 4,
                margin: const EdgeInsets.only(bottom: 20),
                decoration: BoxDecoration(
                  color: isDark ? Colors.white24 : Colors.black12,
                  borderRadius: BorderRadius.circular(2),
                ),
              ),

              // Small Cover Thumbnail
              BookCoverWidget(
                title: novel.title,
                author: novel.author,
                coverPath: novel.coverPath,
                width: 65,
                height: 98,
                borderRadius: 6,
              ),
              const SizedBox(height: 16),

              // Title
              Text(
                'Add to Library?',
                textAlign: TextAlign.center,
                style: TextStyle(
                  fontSize: 20,
                  fontWeight: FontWeight.w700,
                  letterSpacing: -0.3,
                  color: isDark ? Colors.white : Colors.black,
                  fontFamily: 'serif',
                ),
              ),
              const SizedBox(height: 8),

              // Description
              Text(
                'Add "${novel.title}" to your library to find it easily and check for new chapters.',
                textAlign: TextAlign.center,
                style: TextStyle(
                  fontSize: 15,
                  height: 1.35,
                  color: isDark ? HonColors.darkTextSecondary : HonColors.lightTextSecondary,
                ),
              ),
              const SizedBox(height: 24),

              // Action Buttons
              Column(
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
                  // Add to Library Button
                  ElevatedButton(
                    onPressed: () {
                      Navigator.of(ctx).pop(AddToLibraryChoice.addToLibrary);
                    },
                    style: ElevatedButton.styleFrom(
                      backgroundColor: isDark ? Colors.white : Colors.black,
                      foregroundColor: isDark ? Colors.black : Colors.white,
                      elevation: 0,
                      padding: const EdgeInsets.symmetric(vertical: 16),
                      shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(14),
                      ),
                    ),
                    child: const Text(
                      'Add to Library',
                      style: TextStyle(
                        fontSize: 16,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                  ),
                  const SizedBox(height: 10),

                  // Not Now Button
                  TextButton(
                    onPressed: () {
                      Navigator.of(ctx).pop(AddToLibraryChoice.notNow);
                    },
                    style: TextButton.styleFrom(
                      foregroundColor: isDark ? Colors.white70 : Colors.black87,
                      padding: const EdgeInsets.symmetric(vertical: 14),
                      shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(14),
                      ),
                    ),
                    child: const Text(
                      'Not Now',
                      style: TextStyle(
                        fontSize: 16,
                        fontWeight: FontWeight.w500,
                      ),
                    ),
                  ),
                ],
              ),
            ],
          ),
        );
      },
    );

    // Rule: Dismissing the sheet behaves as Not Now
    final choice = result ?? AddToLibraryChoice.notNow;

    if (choice == AddToLibraryChoice.addToLibrary) {
      await db.setLibraryMembership(novel.id, true);
    } else {
      // Rule: Suppress repeat prompts for that novel during the current app session
      db.suppressPromptForSession(novel.id);
    }

    return choice;
  }

  static Future<AddToLibraryChoice> checkAndPrompt(
    BuildContext context, {
    required String novelId,
    required String novelTitle,
    Future<void> Function()? onAddToLibrary,
  }) async {
    final db = DatabaseService.instance;
    if (db.isBookInLibrary(novelId)) return AddToLibraryChoice.addToLibrary;
    if (db.isPromptSuppressedForSession(novelId)) return AddToLibraryChoice.notNow;

    final book = db.getBookById(novelId) ??
        Book(
          id: novelId,
          title: novelTitle,
          author: 'Unknown Author',
          format: BookFormat.webNovel,
          createdAt: DateTime.now(),
          updatedAt: DateTime.now(),
        );

    final choice = await show(context, novel: book);
    if (choice == AddToLibraryChoice.addToLibrary && onAddToLibrary != null) {
      await onAddToLibrary();
    }
    return choice;
  }
}
</file>

<file path="lib/shared/widgets/book_cover_widget.dart">
import 'dart:io';
import 'package:flutter/material.dart';

class BookCoverWidget extends StatelessWidget {
  final String? coverPath;
  final String title;
  final String author;
  final double? width;
  final double? height;
  final double borderRadius;
  final bool showSpineShadow;

  const BookCoverWidget({
    super.key,
    this.coverPath,
    required this.title,
    this.author = '',
    this.width = 90,
    this.height = 135,
    this.borderRadius = 6,
    this.showSpineShadow = true,
  });

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final double w = width != null && width!.isFinite
            ? width!
            : (constraints.maxWidth.isFinite ? constraints.maxWidth : 90.0);
        final double h = height != null && height!.isFinite
            ? height!
            : (constraints.maxHeight.isFinite ? constraints.maxHeight : w * 1.5);

        Widget imageContent;

        if (coverPath != null && coverPath!.isNotEmpty) {
          if (coverPath!.startsWith('assets/')) {
            imageContent = Image.asset(
              coverPath!,
              width: w,
              height: h,
              fit: BoxFit.cover,
              errorBuilder: (_, __, ___) => _buildFallbackCover(w, h),
            );
          } else if (coverPath!.startsWith('http://') || coverPath!.startsWith('https://')) {
            imageContent = Image.network(
              coverPath!,
              width: w,
              height: h,
              fit: BoxFit.cover,
              errorBuilder: (_, __, ___) => _buildFallbackCover(w, h),
            );
          } else {
            final file = File(coverPath!);
            if (file.existsSync()) {
              imageContent = Image.file(
                file,
                width: w,
                height: h,
                fit: BoxFit.cover,
                errorBuilder: (_, __, ___) => _buildFallbackCover(w, h),
              );
            } else {
              imageContent = _buildFallbackCover(w, h);
            }
          }
        } else {
          imageContent = _buildFallbackCover(w, h);
        }

        return Container(
          width: width != null && width!.isFinite ? width : null,
          height: height != null && height!.isFinite ? height : null,
          decoration: BoxDecoration(
            borderRadius: BorderRadius.circular(borderRadius),
            boxShadow: [
              BoxShadow(
                color: Colors.black.withOpacity(0.18),
                blurRadius: 8,
                offset: const Offset(1, 4),
              ),
              BoxShadow(
                color: Colors.black.withOpacity(0.08),
                blurRadius: 2,
                offset: const Offset(0, 1),
              ),
            ],
          ),
          child: ClipRRect(
            borderRadius: BorderRadius.circular(borderRadius),
            child: Stack(
              children: [
                Positioned.fill(child: imageContent),
                if (showSpineShadow)
                  Positioned(
                    left: 0,
                    top: 0,
                    bottom: 0,
                    width: (w * 0.08).clamp(4.0, 16.0),
                    child: Container(
                      decoration: const BoxDecoration(
                        gradient: LinearGradient(
                          colors: [
                            Color(0x55000000),
                            Color(0x22000000),
                            Color(0x00000000),
                          ],
                          begin: Alignment.centerLeft,
                          end: Alignment.centerRight,
                        ),
                      ),
                    ),
                  ),
                // Right-edge subtle highlight for realistic 3D sheen
                Positioned(
                  right: 0,
                  top: 0,
                  bottom: 0,
                  width: 2,
                  child: Container(
                    color: Colors.white.withOpacity(0.12),
                  ),
                ),
              ],
            ),
          ),
        );
      },
    );
  }

  Widget _buildFallbackCover(double w, double h) {
    final hash = title.hashCode.abs();
    final palettes = [
      [const Color(0xFF2C3E50), const Color(0xFF34495E)],
      [const Color(0xFF8E44AD), const Color(0xFF9B59B6)],
      [const Color(0xFFD35400), const Color(0xFFE67E22)],
      [const Color(0xFF16A085), const Color(0xFF1ABC9C)],
      [const Color(0xFF27AE60), const Color(0xFF2ECC71)],
      [const Color(0xFF7F1D1D), const Color(0xFF991B1B)],
      [const Color(0xFF1E3A8A), const Color(0xFF1D4ED8)],
      [const Color(0xFF312E81), const Color(0xFF4338CA)],
    ];
    final gradientColors = palettes[hash % palettes.length];

    return Container(
      width: w,
      height: h,
      decoration: BoxDecoration(
        gradient: LinearGradient(
          colors: gradientColors,
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
        ),
      ),
      padding: EdgeInsets.symmetric(
        horizontal: (w * 0.1).clamp(6.0, 20.0),
        vertical: (h * 0.1).clamp(6.0, 20.0),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Flexible(
            child: Text(
              title,
              maxLines: 4,
              overflow: TextOverflow.ellipsis,
              style: TextStyle(
                color: Colors.white,
                fontWeight: FontWeight.w700,
                fontSize: (w * 0.13).clamp(10.0, 16.0),
                height: 1.2,
                fontFamily: 'serif',
              ),
            ),
          ),
          if (author.isNotEmpty)
            Text(
              author,
              maxLines: 2,
              overflow: TextOverflow.ellipsis,
              style: TextStyle(
                color: Colors.white.withOpacity(0.75),
                fontWeight: FontWeight.w400,
                fontSize: (w * 0.09).clamp(8.0, 12.0),
              ),
            ),
        ],
      ),
    );
  }
}
</file>

