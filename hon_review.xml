    return MaterialApp(
      navigatorKey: HonApp.navigatorKey,
      title: 'Hon',
      debugShowCheckedModeBanner: false,
      theme: HonTheme.lightTheme,
      darkTheme: HonTheme.darkTheme,
      themeMode: ThemeMode.system,
      home: const TabScaffold(),
    );
  }
}
