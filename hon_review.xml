      fontSize: 14,
      fontWeight: FontWeight.w400,
      letterSpacing: -0.1,
      color: color,
    );
  }

  // Meta label (e.g. "Book • 6%")
  static TextStyle cardMeta({Color? color}) {
    return TextStyle(
      fontSize: 12,
      fontWeight: FontWeight.w400,
      color: color,
    );
  }

  // Standard body text
  static TextStyle body({Color? color}) {
    return TextStyle(
      fontSize: 16,
      fontWeight: FontWeight.w400,
      letterSpacing: -0.2,
      color: color,
    );
  }

  // Reader body text (Jane Austen paragraph style)
  static TextStyle readerBody({
    Color? color,
    double fontSize = 18.0,
    double lineHeight = 1.65,
    String? fontFamily,
  }) {
    switch (fontFamily) {
      case 'New York':
        return GoogleFonts.cormorantGaramond(
          fontSize: fontSize,
          height: lineHeight,
          fontWeight: FontWeight.w400,
          color: color,
        );
      case 'San Francisco':
        return TextStyle(
          fontSize: fontSize,
          height: lineHeight,
          fontWeight: FontWeight.w400,
          color: color,
          fontFamily: 'sans-serif',
        );
      case 'Palatino':
      case 'Baskerville':
      case 'Georgia':
      default:
        return GoogleFonts.newsreader(
          fontSize: fontSize,
          height: lineHeight,
          fontWeight: FontWeight.w400,
          color: color,
        );
    }
  }

  // Tab bar labels
  static TextStyle tabLabel({Color? color}) {
    return TextStyle(
      fontSize: 10,
      fontWeight: FontWeight.w500,
      letterSpacing: -0.1,
      color: color,
    );
  }
}
