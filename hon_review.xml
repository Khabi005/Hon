<file path="lib/core/utils/epub_parser.dart">
import 'dart:convert';
import 'dart:io';
import 'dart:typed_data';
import 'package:archive/archive.dart';
import 'package:xml/xml.dart';
import 'package:path/path.dart' as p;

class ParsedEpubMetadata {
  final String title;
  final String author;
  final String description;
  final Uint8List? coverBytes;
  final List<EpubChapterItem> chapters;

  const ParsedEpubMetadata({
    required this.title,
    required this.author,
    required this.description,
    this.coverBytes,
    required this.chapters,
  });
}

class EpubChapterItem {
  final String id;
  final String title;
  final String contentHref;
  final String htmlContent;
  final int? playOrder;

  const EpubChapterItem({
    required this.id,
    required this.title,
    required this.contentHref,
    required this.htmlContent,
    this.playOrder,
  });
}

class EpubParser {
  static String _decodeString(List<int> bytes) {
    try {
      return utf8.decode(bytes);
    } catch (_) {
      try {
        return utf8.decode(bytes, allowMalformed: true);
      } catch (_) {
        return String.fromCharCodes(bytes);
      }
    }
  }

  static Future<ParsedEpubMetadata> parse(File file) async {
    final bytes = await file.readAsBytes();
    final archive = ZipDecoder().decodeBytes(bytes);

    // 1. Locate container.xml
    final containerFile = archive.findFile('META-INF/container.xml');
    if (containerFile == null) {
      throw Exception('Invalid EPUB: META-INF/container.xml missing');
    }

    final containerXml = XmlDocument.parse(_decodeString(containerFile.content as List<int>));
    final rootfile = containerXml.findAllElements('rootfile').firstOrNull;
    final opfPath = rootfile?.getAttribute('full-path') ?? 'OEBPS/content.opf';
    final opfDir = p.dirname(opfPath);

    // 2. Read OPF
    final opfFile = archive.findFile(opfPath);
    if (opfFile == null) {
      throw Exception('Invalid EPUB: Rootfile not found at $opfPath');
    }

    final opfXml = XmlDocument.parse(_decodeString(opfFile.content as List<int>));

    // Extract Title & Author
    final title = opfXml.findAllElements('dc:title').firstOrNull?.innerText.trim() ??
        p.basenameWithoutExtension(file.path);
    final author = opfXml.findAllElements('dc:creator').firstOrNull?.innerText.trim() ??
        'Unknown Author';
    final description = opfXml.findAllElements('dc:description').firstOrNull?.innerText.trim() ?? '';

    // Manifest map: id -> {href, media-type, properties}
    final manifest = <String, Map<String, String>>{};
    String? coverHref;
    String? ncxHref;
    String? navHref;

    for (final item in opfXml.findAllElements('item')) {
      final id = item.getAttribute('id') ?? '';
      final href = item.getAttribute('href') ?? '';
      final mediaType = item.getAttribute('media-type') ?? '';
      final properties = item.getAttribute('properties') ?? '';
      manifest[id] = {'href': href, 'media-type': mediaType, 'properties': properties};

      if (properties.contains('cover-image') || id.toLowerCase().contains('cover')) {
        coverHref = href;
      }
      if (mediaType == 'application/x-dtbncx+xml' || id.toLowerCase() == 'ncx') {
        ncxHref = href;
      }
      if (properties.contains('nav')) {
        navHref = href;
      }
    }

    // Extract Cover image
    Uint8List? coverBytes;
    if (coverHref != null) {
      final fullCoverPath = opfDir == '.' ? coverHref : p.normalize('$opfDir/$coverHref');
      final cFile = archive.findFile(fullCoverPath);
      if (cFile != null) {
        coverBytes = Uint8List.fromList(cFile.content as List<int>);
      }
    }

    // Try parsing Table of Contents from NCX if present
    final tocTitlesByHref = <String, String>{};
    if (ncxHref != null) {
      try {
        final fullNcxPath = opfDir == '.' ? ncxHref : p.normalize('$opfDir/$ncxHref');
        final ncxFile = archive.findFile(fullNcxPath);
        if (ncxFile != null) {
          final ncxDoc = XmlDocument.parse(_decodeString(ncxFile.content as List<int>));
          for (final navPoint in ncxDoc.findAllElements('navPoint')) {
            final label = navPoint.findElements('navLabel').firstOrNull?.findElements('text').firstOrNull?.innerText.trim();
            final src = navPoint.findElements('content').firstOrNull?.getAttribute('src');
            if (label != null && src != null && label.isNotEmpty) {
              final cleanSrc = src.split('#').first;
              tocTitlesByHref[cleanSrc] = label;
              tocTitlesByHref[p.basename(cleanSrc)] = label;
            }
          }
        }
      } catch (_) {}
    }

    // Try parsing Table of Contents from EPUB 3 Nav if present
    if (navHref != null && tocTitlesByHref.isEmpty) {
      try {
        final fullNavPath = opfDir == '.' ? navHref : p.normalize('$opfDir/$navHref');
        final navFile = archive.findFile(fullNavPath);
        if (navFile != null) {
          final navDoc = XmlDocument.parse(_decodeString(navFile.content as List<int>));
          for (final a in navDoc.findAllElements('a')) {
            final href = a.getAttribute('href');
            final label = a.innerText.trim();
            if (href != null && label.isNotEmpty) {
              final cleanSrc = href.split('#').first;
              tocTitlesByHref[cleanSrc] = label;
              tocTitlesByHref[p.basename(cleanSrc)] = label;
            }
          }
        }
      } catch (_) {}
    }

    // Spine
    final spineRefs = opfXml.findAllElements('itemref').map((e) => e.getAttribute('idref') ?? '').toList();

    final chapters = <EpubChapterItem>[];
    for (int i = 0; i < spineRefs.length; i++) {
      final idref = spineRefs[i];
      final itemMeta = manifest[idref];
      if (itemMeta == null) continue;

      final href = itemMeta['href']!;
      final fullPath = opfDir == '.' ? href : p.normalize('$opfDir/$href');
      final contentFile = archive.findFile(fullPath);
      if (contentFile == null) continue;

      final html = _decodeString(contentFile.content as List<int>);

      // Determine chapter title from TOC or from HTML headings
      String chapterTitle = tocTitlesByHref[href] ?? tocTitlesByHref[p.basename(href)] ?? 'Chapter ${i + 1}';
      if (chapterTitle == 'Chapter ${i + 1}') {
        try {
          final doc = XmlDocument.parse(html);
          final h1 = doc.findAllElements('h1').firstOrNull ??
              doc.findAllElements('h2').firstOrNull ??
              doc.findAllElements('title').firstOrNull;
          if (h1 != null && h1.innerText.trim().isNotEmpty) {
            chapterTitle = h1.innerText.trim();
          }
        } catch (_) {}
      }

      chapters.add(EpubChapterItem(
        id: idref,
        title: chapterTitle,
        contentHref: href,
        htmlContent: html,
        playOrder: i + 1,
      ));
    }

    return ParsedEpubMetadata(
      title: title,
      author: author,
      description: description,
      coverBytes: coverBytes,
      chapters: chapters,
    );
  }
}
</file>

<file path="lib/features/browse/presentation/browse_screen.dart">
import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import '../../../app/theme/hon_colors.dart';
import '../../../app/theme/hon_typography.dart';
import '../../../core/sources/source_registry.dart';
import 'source_catalog_screen.dart';

class BrowseScreen extends StatefulWidget {
  const BrowseScreen({super.key});

  @override
  State<BrowseScreen> createState() => _BrowseScreenState();
}

class _BrowseScreenState extends State<BrowseScreen> {
  int _selectedTabIndex = 0; // 0: Sources, 1: Extensions
  String _searchQuery = '';
  final TextEditingController _searchController = TextEditingController();

  @override
  void initState() {
    super.initState();
    SourceRegistry.instance.changeNotifier.addListener(_onRegistryChanged);
  }

  @override
  void dispose() {
    SourceRegistry.instance.changeNotifier.removeListener(_onRegistryChanged);
    _searchController.dispose();
    super.dispose();
  }

  void _onRegistryChanged() {
    if (mounted) setState(() {});
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final textPrimary = isDark ? HonColors.darkTextPrimary : HonColors.lightTextPrimary;
    final textSecondary = isDark ? HonColors.darkTextSecondary : HonColors.lightTextSecondary;

    final installedSources = SourceRegistry.instance.getInstalledSources();
    final allExtensions = SourceRegistry.instance.getExtensions();

    final query = _searchQuery.trim().toLowerCase();
    final displayedSources = query.isEmpty
        ? installedSources
        : installedSources.where((s) => s.name.toLowerCase().contains(query)).toList();

    final displayedExtensions = query.isEmpty
        ? allExtensions
        : allExtensions.where((e) => e.name.toLowerCase().contains(query) || e.lang.toLowerCase().contains(query)).toList();

    final uninstalledCount = allExtensions.where((e) => !e.isInstalled).length;

    return Scaffold(
      backgroundColor: isDark ? HonColors.darkBackground : HonColors.lightBackground,
      body: SafeArea(
        bottom: false,
        child: CustomScrollView(
          physics: const BouncingScrollPhysics(),
          slivers: [
            // Top App Bar
            SliverToBoxAdapter(
              child: Padding(
                padding: const EdgeInsets.fromLTRB(20, 16, 16, 8),
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Text(
                      'Browse',
                      style: HonTypography.largeTitle(color: textPrimary),
                    ),
                    IconButton(
                      icon: Icon(CupertinoIcons.question_circle, color: textSecondary, size: 22),
                      onPressed: () {
                        ScaffoldMessenger.of(context).showSnackBar(
                          const SnackBar(content: Text('Browse online sources & install extensions.')),
                        );
                      },
                    ),
                  ],
                ),
              ),
            ),

            // Segmented Control: Sources | Extensions (Matching Reference Screenshot)
            SliverToBoxAdapter(
              child: Padding(
                padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 6),
                child: Container(
                  height: 38,
                  padding: const EdgeInsets.all(3),
                  decoration: BoxDecoration(
                    color: isDark ? const Color(0xFF2C2C2E) : const Color(0xFFE5E5EA),
                    borderRadius: BorderRadius.circular(10),
                  ),
                  child: Row(
                    children: [
                      _buildTabButton('Sources', 0, null, isDark),
                      _buildTabButton('Extensions', 1, uninstalledCount > 0 ? '$uninstalledCount' : null, isDark),
                    ],
                  ),
                ),
              ),
            ),

            // Search Bar for Current Tab
            SliverToBoxAdapter(
              child: Padding(
                padding: const EdgeInsets.fromLTRB(20, 10, 20, 12),
                child: CupertinoSearchTextField(
                  controller: _searchController,
                  style: TextStyle(color: textPrimary),
                  placeholder: _selectedTabIndex == 0
                      ? 'Search installed sources...'
                      : 'Search repository extensions...',
                  onChanged: (val) => setState(() => _searchQuery = val),
                ),
              ),
            ),

            // Tab View Body
            if (_selectedTabIndex == 0)
              _buildSourcesList(displayedSources, textPrimary, textSecondary, isDark)
            else
              _buildExtensionsList(displayedExtensions, textPrimary, textSecondary, isDark),

            const SliverToBoxAdapter(child: SizedBox(height: 100)),
          ],
        ),
      ),
    );
  }

  Widget _buildTabButton(String title, int index, String? badge, bool isDark) {
    final isSelected = _selectedTabIndex == index;
    return Expanded(
      child: GestureDetector(
        onTap: () {
          setState(() {
            _selectedTabIndex = index;
            _searchQuery = '';
            _searchController.clear();
          });
        },
        child: Container(
          decoration: BoxDecoration(
            color: isSelected
                ? (isDark ? const Color(0xFF3A3A3C) : Colors.white)
                : Colors.transparent,
            borderRadius: BorderRadius.circular(8),
            boxShadow: isSelected
                ? [
                    BoxShadow(
                      color: Colors.black.withOpacity(0.08),
                      blurRadius: 4,
                      offset: const Offset(0, 1),
                    )
                  ]
                : null,
          ),
          alignment: Alignment.center,
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Text(
                title,
                style: TextStyle(
                  fontSize: 13,
                  fontWeight: isSelected ? FontWeight.w700 : FontWeight.w500,
                  color: isSelected
                      ? (isDark ? Colors.white : Colors.black)
                      : (isDark ? Colors.white60 : Colors.black54),
                ),
              ),
              if (badge != null) ...[
                const SizedBox(width: 6),
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 5, vertical: 1),
                  decoration: BoxDecoration(
                    color: HonColors.accentOrange,
                    borderRadius: BorderRadius.circular(10),
                  ),
                  child: Text(
                    badge,
                    style: const TextStyle(fontSize: 10, color: Colors.white, fontWeight: FontWeight.bold),
                  ),
                ),
              ],
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildSourcesList(
    List<ExtensionMeta> sources,
    Color textPrimary,
    Color textSecondary,
    bool isDark,
  ) {
    if (sources.isEmpty) {
      return SliverFillRemaining(
        child: Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Icon(CupertinoIcons.compass, size: 48, color: textSecondary.withOpacity(0.4)),
              const SizedBox(height: 12),
              Text(
                'No Sources Installed',
                style: TextStyle(fontSize: 16, fontWeight: FontWeight.w600, color: textPrimary),
              ),
              const SizedBox(height: 6),
              Text(
                'Switch to the Extensions tab to install novel sources.',
                style: TextStyle(fontSize: 13, color: textSecondary),
              ),
            ],
          ),
        ),
      );
    }

    return SliverPadding(
      padding: const EdgeInsets.symmetric(horizontal: 20),
      sliver: SliverList(
        delegate: SliverChildBuilderDelegate(
          (context, index) {
            final source = sources[index];
            return Padding(
              padding: const EdgeInsets.symmetric(vertical: 6),
              child: InkWell(
                onTap: () {
                  Navigator.of(context).push(
                    MaterialPageRoute(
                      builder: (_) => SourceCatalogScreen(sourceMeta: source),
                    ),
                  );
                },
                borderRadius: BorderRadius.circular(12),
                child: Container(
                  padding: const EdgeInsets.all(12),
                  decoration: BoxDecoration(
                    color: isDark ? const Color(0xFF1E1E20) : const Color(0xFFF2F2F7),
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(
                      color: isDark ? Colors.white10 : Colors.black.withOpacity(0.06),
                      width: 0.5,
                    ),
                  ),
                  child: Row(
                    children: [
                      // Source Icon Avatar
                      Container(
                        width: 44,
                        height: 44,
                        decoration: BoxDecoration(
                          color: const Color(0xFF2B4353),
                          borderRadius: BorderRadius.circular(8),
                        ),
                        alignment: Alignment.center,
                        child: Text(
                          source.name.substring(0, 1),
                          style: const TextStyle(
                            fontSize: 18,
                            fontWeight: FontWeight.bold,
                            color: Colors.white,
                          ),
                        ),
                      ),
                      const SizedBox(width: 14),

                      // Name & Language
                      Expanded(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Text(
                              source.name,
                              style: TextStyle(
                                fontSize: 15,
                                fontWeight: FontWeight.w600,
                                color: textPrimary,
                              ),
                            ),
                            const SizedBox(height: 3),
                            Text(
                              '${source.lang} • v${source.version}',
                              style: TextStyle(fontSize: 12, color: textSecondary),
                            ),
                          ],
                        ),
                      ),

                      // "Latest" button & Pin icon (matching reference)
                      TextButton(
                        onPressed: () {
                          Navigator.of(context).push(
                            MaterialPageRoute(
                              builder: (_) => SourceCatalogScreen(sourceMeta: source),
                            ),
                          );
                        },
                        child: const Text('Latest', style: TextStyle(fontSize: 13, fontWeight: FontWeight.w600)),
                      ),
                      Icon(CupertinoIcons.pin, size: 16, color: textSecondary),
                    ],
                  ),
                ),
              ),
            );
          },
          childCount: sources.length,
        ),
      ),
    );
  }

  Widget _buildExtensionsList(
    List<ExtensionMeta> extensions,
    Color textPrimary,
    Color textSecondary,
    bool isDark,
  ) {
    return SliverPadding(
      padding: const EdgeInsets.symmetric(horizontal: 20),
      sliver: SliverList(
        delegate: SliverChildBuilderDelegate(
          (context, index) {
            final ext = extensions[index];
            return Padding(
              padding: const EdgeInsets.symmetric(vertical: 6),
              child: Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: isDark ? const Color(0xFF1E1E20) : const Color(0xFFF2F2F7),
                  borderRadius: BorderRadius.circular(12),
                  border: Border.all(
                    color: isDark ? Colors.white10 : Colors.black.withOpacity(0.06),
                    width: 0.5,
                  ),
                ),
                child: Row(
                  children: [
                    Container(
                      width: 44,
                      height: 44,
                      decoration: BoxDecoration(
                        color: ext.isInstalled ? const Color(0xFF1B4965) : const Color(0xFF3D3D3D),
                        borderRadius: BorderRadius.circular(8),
                      ),
                      alignment: Alignment.center,
                      child: Text(
                        ext.name.substring(0, 1),
                        style: const TextStyle(
                          fontSize: 18,
                          fontWeight: FontWeight.bold,
                          color: Colors.white,
                        ),
                      ),
                    ),
                    const SizedBox(width: 14),

                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            ext.name,
                            style: TextStyle(
                              fontSize: 15,
                              fontWeight: FontWeight.w600,
                              color: textPrimary,
                            ),
                          ),
                          const SizedBox(height: 3),
                          Text(
                            '${ext.lang} • ${ext.version}',
                            style: TextStyle(fontSize: 12, color: textSecondary),
                          ),
                        ],
                      ),
                    ),

                    // Install / Uninstall action
                    if (ext.isInstalled)
                      IconButton(
                        icon: const Icon(CupertinoIcons.gear_alt, size: 20),
                        color: textSecondary,
                        onPressed: () {
                          _showExtensionSettings(ext);
                        },
                      )
                    else
                      IconButton(
                        icon: const Icon(CupertinoIcons.arrow_down_to_line_alt, size: 20),
                        color: HonColors.accentOrange,
                        onPressed: () async {
                          await SourceRegistry.instance.installExtension(ext.id);
                          if (!context.mounted) return;
                          ScaffoldMessenger.of(context).showSnackBar(
                            SnackBar(content: Text('Installed ${ext.name}! Available in Sources tab.')),
                          );
                        },
                      ),
                  ],
                ),
              ),
            );
          },
          childCount: extensions.length,
        ),
      ),
    );
  }

  void _showExtensionSettings(ExtensionMeta ext) {
    showCupertinoModalPopup(
      context: context,
      builder: (ctx) => CupertinoActionSheet(
        title: Text(ext.name),
        message: Text('${ext.lang} • v${ext.version}\n${ext.description}'),
        actions: [
          CupertinoActionSheetAction(
            isDestructiveAction: true,
            child: const Text('Uninstall Extension'),
            onPressed: () async {
              Navigator.of(ctx).pop();
              await SourceRegistry.instance.uninstallExtension(ext.id);
            },
          ),
        ],
        cancelButton: CupertinoActionSheetAction(
          child: const Text('Cancel'),
          onPressed: () => Navigator.of(ctx).pop(),
        ),
      ),
    );
  }
}
</file>

<file path="lib/features/downloads/presentation/downloads_screen.dart">
import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import '../../../app/bootstrap/providers.dart';
import '../../../app/theme/hon_colors.dart';
import '../../../app/theme/hon_typography.dart';
import '../../../core/database/database_service.dart';
import '../../../core/models/book.dart';
import '../../../core/models/download_job.dart';
import '../../../shared/widgets/book_cover_widget.dart';
import '../../reader/presentation/reader_navigator.dart';

class ChapterUpdateItem {
  final String novelTitle;
  final String chapterTitle;
  final String date;
  final bool isDownloaded;
  final Book? book;

  const ChapterUpdateItem({
    required this.novelTitle,
    required this.chapterTitle,
    required this.date,
    this.isDownloaded = false,
    this.book,
  });
}

class DownloadsScreen extends ConsumerStatefulWidget {
  const DownloadsScreen({super.key});

  @override
  ConsumerState<DownloadsScreen> createState() => _DownloadsScreenState();
}

class _DownloadsScreenState extends ConsumerState<DownloadsScreen> {
  int _selectedTabIndex = 0; // 0: Downloads, 1: Updates

  @override
  Widget build(BuildContext context) {
    final jobs = ref.watch(allDownloadJobsProvider);
    final libraryBooks = ref.watch(libraryBooksProvider);
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final textPrimary = isDark ? HonColors.darkTextPrimary : HonColors.lightTextPrimary;
    final textSecondary = isDark ? HonColors.darkTextSecondary : HonColors.lightTextSecondary;

    return Scaffold(
      backgroundColor: isDark ? HonColors.darkBackground : HonColors.lightBackground,
      body: SafeArea(
        bottom: false,
        child: CustomScrollView(
          physics: const BouncingScrollPhysics(),
          slivers: [
            // Header Bar
            SliverToBoxAdapter(
              child: Padding(
                padding: const EdgeInsets.fromLTRB(20, 16, 20, 6),
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Text(
                      _selectedTabIndex == 0 ? 'Downloads' : 'Updates',
                      style: HonTypography.largeTitle(color: textPrimary),
                    ),
                    if (_selectedTabIndex == 0 && jobs.isNotEmpty)
                      TextButton(
                        onPressed: () {
                          final db = DatabaseService.instance;
                          for (final j in jobs) {
                            if (j.status == DownloadStatus.completed) {
                              db.removeDownloadJob(j.id);
                            }
                          }
                        },
                        child: const Text('Clear Completed'),
                      )
                    else if (_selectedTabIndex == 1)
                      IconButton(
                        icon: const Icon(CupertinoIcons.arrow_clockwise, size: 20),
                        color: textPrimary,
                        onPressed: () {
                          ScaffoldMessenger.of(context).showSnackBar(
                            const SnackBar(content: Text('Checking library novels for new chapters...')),
                          );
                        },
                      ),
                  ],
                ),
              ),
            ),

            // Mini Tabs: Downloads | Updates
            SliverToBoxAdapter(
              child: Padding(
                padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 8),
                child: Container(
                  height: 36,
                  padding: const EdgeInsets.all(3),
                  decoration: BoxDecoration(
                    color: isDark ? const Color(0xFF2C2C2E) : const Color(0xFFE5E5EA),
                    borderRadius: BorderRadius.circular(10),
                  ),
                  child: Row(
                    children: [
                      _buildTabButton('Downloads', 0, jobs.isNotEmpty ? '${jobs.length}' : null, isDark),
                      _buildTabButton('Updates', 1, null, isDark),
                    ],
                  ),
                ),
              ),
            ),

            // Content Body based on selected tab
            if (_selectedTabIndex == 0)
              ..._buildDownloadsTab(jobs, textPrimary, textSecondary, isDark)
            else
              ..._buildUpdatesTab(libraryBooks, textPrimary, textSecondary, isDark),

            const SliverToBoxAdapter(child: SizedBox(height: 100)),
          ],
        ),
      ),
    );
  }

  Widget _buildTabButton(String title, int index, String? badge, bool isDark) {
    final isSelected = _selectedTabIndex == index;
    return Expanded(
      child: GestureDetector(
        onTap: () => setState(() => _selectedTabIndex = index),
        child: Container(
          decoration: BoxDecoration(
            color: isSelected
                ? (isDark ? const Color(0xFF3A3A3C) : Colors.white)
                : Colors.transparent,
            borderRadius: BorderRadius.circular(7),
            boxShadow: isSelected
                ? [
                    BoxShadow(
                      color: Colors.black.withOpacity(0.08),
                      blurRadius: 4,
                      offset: const Offset(0, 1),
                    )
                  ]
                : null,
          ),
          alignment: Alignment.center,
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Text(
                title,
                style: TextStyle(
                  fontSize: 13,
                  fontWeight: isSelected ? FontWeight.w700 : FontWeight.w500,
                  color: isSelected
                      ? (isDark ? Colors.white : Colors.black)
                      : (isDark ? Colors.white60 : Colors.black54),
                ),
              ),
              if (badge != null) ...[
                const SizedBox(width: 6),
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 5, vertical: 1),
                  decoration: BoxDecoration(
                    color: HonColors.accentOrange,
                    borderRadius: BorderRadius.circular(10),
                  ),
                  child: Text(
                    badge,
                    style: const TextStyle(fontSize: 10, color: Colors.white, fontWeight: FontWeight.bold),
                  ),
                ),
              ],
            ],
          ),
        ),
      ),
    );
  }

  List<Widget> _buildDownloadsTab(
    List<DownloadJob> jobs,
    Color textPrimary,
    Color textSecondary,
    bool isDark,
  ) {
    return [
      // Storage Overview Card
      SliverToBoxAdapter(
        child: Padding(
          padding: const EdgeInsets.fromLTRB(20, 8, 20, 16),
          child: Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: isDark ? HonColors.darkSurface : HonColors.lightSurface,
              borderRadius: BorderRadius.circular(16),
              border: Border.all(
                color: isDark ? HonColors.darkCardBorder : HonColors.lightCardBorder,
                width: 0.5,
              ),
            ),
            child: Row(
              children: [
                Container(
                  width: 40,
                  height: 40,
                  decoration: BoxDecoration(
                    color: HonColors.accentGreen.withOpacity(0.15),
                    borderRadius: BorderRadius.circular(10),
                  ),
                  child: const Icon(
                    CupertinoIcons.device_phone_portrait,
                    color: HonColors.accentGreen,
                    size: 20,
                  ),
                ),
                const SizedBox(width: 14),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        'Offline Reading Storage',
                        style: TextStyle(
                          fontSize: 14,
                          fontWeight: FontWeight.w700,
                          color: textPrimary,
                        ),
                      ),
                      const SizedBox(height: 2),
                      Text(
                        '${jobs.where((j) => j.status == DownloadStatus.completed).length} chapters ready offline in airplane mode.',
                        style: TextStyle(fontSize: 12, color: textSecondary),
                      ),
                    ],
                  ),
                ),
              ],
            ),
          ),
        ),
      ),

      // Jobs List
      if (jobs.isEmpty)
        SliverFillRemaining(
          child: Center(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Icon(
                  CupertinoIcons.arrow_down_circle,
                  size: 56,
                  color: isDark ? Colors.white24 : Colors.black26,
                ),
                const SizedBox(height: 16),
                Text(
                  'No Active Downloads',
                  style: TextStyle(fontSize: 17, fontWeight: FontWeight.w600, color: textPrimary),
                ),
                const SizedBox(height: 6),
                Text(
                  'Novel chapters queued for offline reading appear here.',
                  style: TextStyle(fontSize: 13, color: textSecondary),
                ),
              ],
            ),
          ),
        )
      else
        SliverPadding(
          padding: const EdgeInsets.symmetric(horizontal: 20),
          sliver: SliverList(
            delegate: SliverChildBuilderDelegate(
              (context, index) {
                final job = jobs[index];
                return Padding(
                  padding: const EdgeInsets.only(bottom: 10),
                  child: Container(
                    padding: const EdgeInsets.all(14),
                    decoration: BoxDecoration(
                      color: isDark ? const Color(0xFF1E1E20) : const Color(0xFFF2F2F7),
                      borderRadius: BorderRadius.circular(14),
                      border: Border.all(
                        color: isDark ? Colors.white10 : Colors.black.withOpacity(0.06),
                        width: 0.5,
                      ),
                    ),
                    child: Row(
                      children: [
                        Icon(
                          job.status == DownloadStatus.completed
                              ? CupertinoIcons.check_mark_circled_solid
                              : CupertinoIcons.arrow_down_circle,
                          color: job.status == DownloadStatus.completed
                              ? HonColors.accentGreen
                              : HonColors.accentOrange,
                          size: 24,
                        ),
                        const SizedBox(width: 14),
                        Expanded(
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Text(
                                job.chapterTitle,
                                style: TextStyle(
                                  fontSize: 15,
                                  fontWeight: FontWeight.w600,
                                  color: textPrimary,
                                ),
                              ),
                              const SizedBox(height: 2),
                              Text(
                                job.status == DownloadStatus.completed
                                    ? 'Downloaded & ready offline'
                                    : 'Downloading... ${(job.progress * 100).toInt()}%',
                                style: TextStyle(fontSize: 12, color: textSecondary),
                              ),
                            ],
                          ),
                        ),
                        if (job.status == DownloadStatus.completed)
                          TextButton(
                            child: const Text('Read'),
                            onPressed: () {
                              final book = DatabaseService.instance.getBookById(job.bookId);
                              if (book != null) {
                                ReaderNavigator.openBook(context, book);
                              }
                            },
                          ),
                      ],
                    ),
                  ),
                );
              },
              childCount: jobs.length,
            ),
          ),
        ),
    ];
  }

  List<Widget> _buildUpdatesTab(
    List<Book> libraryBooks,
    Color textPrimary,
    Color textSecondary,
    bool isDark,
  ) {
    // Note: Live upstream chapter updates will be populated when Phase 0C Lua extensions are integrated.
    // We intentionally do not fabricate mock updates.
    final updates = <ChapterUpdateItem>[];

    return [
      if (updates.isEmpty)
        SliverFillRemaining(
          child: Center(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Icon(CupertinoIcons.clock, size: 48, color: textSecondary.withOpacity(0.4)),
                const SizedBox(height: 12),
                Text(
                  'No Chapter Updates',
                  style: TextStyle(fontSize: 16, fontWeight: FontWeight.w600, color: textPrimary),
                ),
                const SizedBox(height: 6),
                Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 32),
                  child: Text(
                    'Chapter update tracking will be activated once novel extensions are connected in Phase 0C.',
                    textAlign: TextAlign.center,
                    style: TextStyle(fontSize: 13, color: textSecondary),
                  ),
                ),
              ],
            ),
          ),
        )
      else
        SliverPadding(
          padding: const EdgeInsets.symmetric(horizontal: 20),
          sliver: SliverList(
            delegate: SliverChildBuilderDelegate(
              (context, index) {
                final item = updates[index];
                return Padding(
                  padding: const EdgeInsets.symmetric(vertical: 6),
                  child: InkWell(
                    onTap: () {
                      if (item.book != null) {
                        ReaderNavigator.openBook(context, item.book!);
                      }
                    },
                    borderRadius: BorderRadius.circular(12),
                    child: Container(
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: isDark ? const Color(0xFF1E1E20) : const Color(0xFFF2F2F7),
                        borderRadius: BorderRadius.circular(12),
                        border: Border.all(
                          color: isDark ? Colors.white10 : Colors.black.withOpacity(0.06),
                          width: 0.5,
                        ),
                      ),
                      child: Row(
                        children: [
                          if (item.book != null)
                            BookCoverWidget(
                              title: item.book!.title,
                              author: item.book!.author,
                              coverPath: item.book!.coverPath,
                              width: 44,
                              height: 62,
                              borderRadius: 4,
                            )
                          else
                            Container(
                              width: 44,
                              height: 62,
                              decoration: BoxDecoration(
                                color: HonColors.accentOrange.withOpacity(0.2),
                                borderRadius: BorderRadius.circular(4),
                              ),
                              child: const Icon(CupertinoIcons.book, size: 20),
                            ),
                          const SizedBox(width: 14),

                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  item.novelTitle,
                                  maxLines: 1,
                                  overflow: TextOverflow.ellipsis,
                                  style: TextStyle(
                                    fontSize: 15,
                                    fontWeight: FontWeight.w600,
                                    color: textPrimary,
                                  ),
                                ),
                                const SizedBox(height: 3),
                                Row(
                                  children: [
                                    Container(
                                      width: 6,
                                      height: 6,
                                      decoration: const BoxDecoration(
                                        color: HonColors.accentBlue,
                                        shape: BoxShape.circle,
                                      ),
                                    ),
                                    const SizedBox(width: 6),
                                    Text(
                                      item.chapterTitle,
                                      style: TextStyle(
                                        fontSize: 13,
                                        color: textSecondary,
                                        fontWeight: FontWeight.w500,
                                      ),
                                    ),
                                  ],
                                ),
                              ],
                            ),
                          ),

                          Icon(
                            item.isDownloaded
                                ? CupertinoIcons.check_mark_circled_solid
                                : CupertinoIcons.arrow_down_circle,
                            color: item.isDownloaded ? HonColors.accentGreen : textSecondary,
                            size: 22,
                          ),
                        ],
                      ),
                    ),
                  ),
                );
              },
              childCount: updates.length,
            ),
          ),
        ),
    ];
  }
}
</file>

<file path="lib/features/home/presentation/widgets/continue_reading_card.dart">
import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import '../../../../core/database/database_service.dart';
import '../../../../core/models/book.dart';
import '../../../../core/models/reading_progress.dart';
import '../../../../shared/widgets/book_cover_widget.dart';
import '../../../reader/presentation/reader_navigator.dart';

class ContinueReadingCard extends StatelessWidget {
  final Book book;
  final ReadingProgress? progress;

  const ContinueReadingCard({
    super.key,
    required this.book,
    this.progress,
  });

  @override
  Widget build(BuildContext context) {
    final pct = progress != null ? (progress!.completionPercentage * 100).toInt() : 0;

    // Card gradient based on book identity
    final hash = book.title.hashCode.abs();
    final gradients = [
      [const Color(0xFF634133), const Color(0xFF8B5A2B)],
      [const Color(0xFF2B4353), const Color(0xFF456268)],
      [const Color(0xFF3B2F4C), const Color(0xFF5D4E6D)],
      [const Color(0xFF2C4A3E), const Color(0xFF43655A)],
      [const Color(0xFF5B323E), const Color(0xFF7A4A58)],
    ];
    final gradient = gradients[hash % gradients.length];

    return GestureDetector(
      onTap: () => ReaderNavigator.openBook(context, book),
      child: Container(
        width: 290,
        height: 120,
        decoration: BoxDecoration(
          borderRadius: BorderRadius.circular(18),
          gradient: LinearGradient(
            colors: gradient,
            begin: Alignment.topLeft,
            end: Alignment.bottomRight,
          ),
          boxShadow: [
            BoxShadow(
              color: gradient[0].withOpacity(0.35),
              blurRadius: 12,
              offset: const Offset(0, 5),
            ),
          ],
        ),
        padding: const EdgeInsets.all(12),
        child: Row(
          children: [
            // Left: Book Cover
            BookCoverWidget(
              title: book.title,
              author: book.author,
              coverPath: book.coverPath,
              width: 64,
              height: 96,
              borderRadius: 6,
            ),
            const SizedBox(width: 14),

            // Middle: Title, Author, Progress
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Text(
                    book.title,
                    maxLines: 2,
                    overflow: TextOverflow.ellipsis,
                    style: const TextStyle(
                      color: Colors.white,
                      fontSize: 16,
                      fontWeight: FontWeight.w700,
                      letterSpacing: -0.2,
                    ),
                  ),
                  const SizedBox(height: 3),
                  Text(
                    book.author,
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                    style: TextStyle(
                      color: Colors.white.withOpacity(0.75),
                      fontSize: 13,
                      fontWeight: FontWeight.w400,
                    ),
                  ),
                  const SizedBox(height: 6),
                  Text(
                    'Book • $pct%',
                    style: TextStyle(
                      color: Colors.white.withOpacity(0.9),
                      fontSize: 12,
                      fontWeight: FontWeight.w500,
                    ),
                  ),
                ],
              ),
            ),

            // Right: Three dots action menu
            Align(
              alignment: Alignment.topRight,
              child: IconButton(
                icon: const Icon(
                  CupertinoIcons.ellipsis,
                  color: Colors.white70,
                  size: 20,
                ),
                padding: EdgeInsets.zero,
                constraints: const BoxConstraints(),
                onPressed: () {
                  _showBookContextMenu(context);
                },
              ),
            ),
          ],
        ),
      ),
    );
  }

  void _showBookContextMenu(BuildContext context) {
    showCupertinoModalPopup(
      context: context,
      builder: (ctx) => CupertinoActionSheet(
        title: Text(book.title),
        message: Text(book.author),
        actions: [
          CupertinoActionSheetAction(
            child: const Text('Read from Last Location'),
            onPressed: () {
              Navigator.of(ctx).pop();
              ReaderNavigator.openBook(context, book);
            },
          ),
          CupertinoActionSheetAction(
            child: const Text('Mark as Finished'),
            onPressed: () {
              DatabaseService.instance.markBookFinished(book.id, true);
              Navigator.of(ctx).pop();
            },
          ),
        ],
        cancelButton: CupertinoActionSheetAction(
          isDefaultAction: true,
          child: const Text('Cancel'),
          onPressed: () => Navigator.of(ctx).pop(),
        ),
      ),
    );
  }
}
</file>

<file path="lib/features/home/presentation/home_screen.dart">
import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import '../../../app/bootstrap/providers.dart';
import '../../../app/theme/hon_colors.dart';
import '../../../app/theme/hon_typography.dart';
import '../../../core/database/database_service.dart';
import '../../../shared/widgets/book_cover_widget.dart';
import '../../reader/presentation/reader_navigator.dart';
import '../../settings/presentation/settings_screen.dart';
import 'widgets/continue_reading_card.dart';
import 'widgets/reading_goals_sheet.dart';

class HomeScreen extends ConsumerWidget {
  const HomeScreen({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final continueBooks = ref.watch(continueReadingProvider);
    final isDark = Theme.of(context).brightness == Brightness.dark;
