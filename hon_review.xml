                ),
                IconButton(
                  icon: const Icon(CupertinoIcons.check_mark_circled_solid, size: 28),
                  color: isDark ? Colors.white70 : Colors.black87,
                  onPressed: () => Navigator.of(context).pop(),
                ),
              ],
            ),
          ),

          const SizedBox(height: 6),

