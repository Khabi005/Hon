              ),
              const SizedBox(height: 6),
              Text(
                'Tap the bookmark button in the top bar to save pages for quick reference.',
                textAlign: TextAlign.center,
                style: TextStyle(
                  fontSize: 13,
                  color: subtextColor,
                ),
              ),
            ],
          ),
        ),
      );
    }

    return ListView.separated(
      physics: const BouncingScrollPhysics(),
      padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 10),
      itemCount: _bookmarks.length,
      separatorBuilder: (_, __) => Divider(
        height: 1,
        color: isDark ? Colors.white10 : Colors.black.withOpacity(0.06),
      ),
      itemBuilder: (context, index) {
        final bm = _bookmarks[index];
        final isCurrent = bm.pageIndex == widget.currentPage;

        return ListTile(
          contentPadding: const EdgeInsets.symmetric(horizontal: 4, vertical: 4),
          leading: Container(
            width: 36,
            height: 36,
            decoration: BoxDecoration(
              color: isCurrent
                  ? const Color(0xFF007AFF).withOpacity(0.15)
                  : (isDark ? Colors.white10 : Colors.black.withOpacity(0.04)),
              shape: BoxShape.circle,
            ),
            child: Icon(
              CupertinoIcons.bookmark_fill,
              size: 18,
              color: isCurrent ? const Color(0xFF007AFF) : subtextColor,
            ),
          ),
          title: Text(
            bm.label,
            style: TextStyle(
              fontSize: 15,
              fontWeight: isCurrent ? FontWeight.w700 : FontWeight.w500,
              color: isCurrent ? const Color(0xFF007AFF) : textColor,
            ),
          ),
          subtitle: Text(
            'Page ${bm.pageIndex} of ${widget.totalPages}',
            style: TextStyle(
              fontSize: 12,
              color: subtextColor,
            ),
          ),
          trailing: IconButton(
            icon: Icon(
              CupertinoIcons.trash,
              size: 18,
              color: isDark ? Colors.white38 : Colors.black38,
            ),
            onPressed: () => _deleteBookmark(bm),
          ),
          onTap: () {
            widget.onSelectPage(bm.pageIndex);
            Navigator.of(context).pop();
          },
        );
      },
    );
  }

  Widget _buildPageGrid(Color textColor, Color subtextColor, bool isDark) {
    if (widget.totalPages <= 0) {
      return Center(
        child: Text(
          'No pages available.',
          style: TextStyle(color: subtextColor),
        ),
      );
    }

    return GridView.builder(
      physics: const BouncingScrollPhysics(),
      padding: const EdgeInsets.all(20),
      gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
        crossAxisCount: 4,
        mainAxisSpacing: 16,
        crossAxisSpacing: 16,
        childAspectRatio: 0.72,
      ),
      itemCount: widget.totalPages,
      itemBuilder: (context, index) {
        final pageNum = index + 1;
        final isCurrent = pageNum == widget.currentPage;
        final isBookmarked = _bookmarks.any((b) => b.pageIndex == pageNum);

        return GestureDetector(
          onTap: () {
            widget.onSelectPage(pageNum);
            Navigator.of(context).pop();
          },
          child: Container(
            decoration: BoxDecoration(
              color: isCurrent
                  ? const Color(0xFF007AFF).withOpacity(0.12)
                  : (isDark ? const Color(0xFF2C2C2E) : const Color(0xFFF2F2F7)),
              borderRadius: BorderRadius.circular(10),
              border: Border.all(
                color: isCurrent
                    ? const Color(0xFF007AFF)
                    : (isDark ? Colors.white12 : Colors.black12),
                width: isCurrent ? 2 : 1,
              ),
            ),
            child: Stack(
              children: [
                Center(
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      Icon(
                        CupertinoIcons.doc_text,
                        size: 26,
                        color: isCurrent
                            ? const Color(0xFF007AFF)
                            : (isDark ? Colors.white54 : Colors.black45),
                      ),
                      const SizedBox(height: 6),
                      Text(
                        '$pageNum',
                        style: TextStyle(
                          fontSize: 14,
                          fontWeight:
                              isCurrent ? FontWeight.w700 : FontWeight.w600,
                          color: isCurrent
                              ? const Color(0xFF007AFF)
                              : textColor,
                        ),
                      ),
                    ],
                  ),
                ),
                if (isBookmarked)
                  const Positioned(
                    top: 6,
                    right: 6,
                    child: Icon(
                      CupertinoIcons.bookmark_fill,
                      size: 14,
                      color: Color(0xFF007AFF),
                    ),
                  ),
              ],
            ),
          ),
        );
      },
    );
  }
}
