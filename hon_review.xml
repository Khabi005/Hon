<file path="lib/features/downloads/presentation/downloads_screen.dart">
import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import '../../../app/bootstrap/providers.dart';
import '../../../app/theme/hon_colors.dart';
import '../../../app/theme/hon_typography.dart';
import '../../../core/database/database_service.dart';
import '../../../core/models/book.dart';
import '../../../core/models/download_job.dart';
import '../../../shared/widgets/book_cover_widget.dart';
import '../../reader/presentation/reader_navigator.dart';

class ChapterUpdateItem {
  final String novelTitle;
  final String chapterTitle;
  final String date;
  final bool isDownloaded;
  final Book? book;

  const ChapterUpdateItem({
    required this.novelTitle,
    required this.chapterTitle,
    required this.date,
    this.isDownloaded = false,
    this.book,
  });
}

class DownloadsScreen extends ConsumerStatefulWidget {
  const DownloadsScreen({super.key});

  @override
  ConsumerState<DownloadsScreen> createState() => _DownloadsScreenState();
}

class _DownloadsScreenState extends ConsumerState<DownloadsScreen> {
  int _selectedTabIndex = 0; // 0: Downloads, 1: Updates

  @override
  Widget build(BuildContext context) {
    final jobs = ref.watch(allDownloadJobsProvider);
    final libraryBooks = ref.watch(libraryBooksProvider);
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final textPrimary = isDark ? HonColors.darkTextPrimary : HonColors.lightTextPrimary;
    final textSecondary = isDark ? HonColors.darkTextSecondary : HonColors.lightTextSecondary;

    return Scaffold(
      backgroundColor: isDark ? HonColors.darkBackground : HonColors.lightBackground,
      body: SafeArea(
        bottom: false,
        child: CustomScrollView(
          physics: const BouncingScrollPhysics(),
          slivers: [
            // Header Bar
            SliverToBoxAdapter(
              child: Padding(
                padding: const EdgeInsets.fromLTRB(20, 16, 20, 6),
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Text(
                      _selectedTabIndex == 0 ? 'Downloads' : 'Updates',
                      style: HonTypography.largeTitle(color: textPrimary),
                    ),
                    if (_selectedTabIndex == 0 && jobs.isNotEmpty)
                      TextButton(
                        onPressed: () {
                          final db = DatabaseService.instance;
                          for (final j in jobs) {
                            if (j.status == DownloadStatus.completed) {
                              db.removeDownloadJob(j.id);
                            }
                          }
                        },
                        child: const Text('Clear Completed'),
                      )
                    else if (_selectedTabIndex == 1)
                      IconButton(
                        icon: const Icon(CupertinoIcons.arrow_clockwise, size: 20),
                        color: textPrimary,
                        onPressed: () {
                          ScaffoldMessenger.of(context).showSnackBar(
                            const SnackBar(content: Text('Checking library novels for new chapters...')),
                          );
                        },
                      ),
                  ],
                ),
              ),
            ),

            // Mini Tabs: Downloads | Updates
            SliverToBoxAdapter(
              child: Padding(
                padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 8),
                child: Container(
                  height: 36,
                  padding: const EdgeInsets.all(3),
                  decoration: BoxDecoration(
                    color: isDark ? const Color(0xFF2C2C2E) : const Color(0xFFE5E5EA),
                    borderRadius: BorderRadius.circular(10),
                  ),
                  child: Row(
                    children: [
                      _buildTabButton('Downloads', 0, jobs.isNotEmpty ? '${jobs.length}' : null, isDark),
                      _buildTabButton('Updates', 1, null, isDark),
                    ],
                  ),
                ),
              ),
            ),

            // Content Body based on selected tab
            if (_selectedTabIndex == 0)
              ..._buildDownloadsTab(jobs, textPrimary, textSecondary, isDark)
            else
              ..._buildUpdatesTab(libraryBooks, textPrimary, textSecondary, isDark),

            const SliverToBoxAdapter(child: SizedBox(height: 100)),
          ],
        ),
      ),
    );
  }

  Widget _buildTabButton(String title, int index, String? badge, bool isDark) {
    final isSelected = _selectedTabIndex == index;
    return Expanded(
      child: GestureDetector(
        onTap: () => setState(() => _selectedTabIndex = index),
        child: Container(
          decoration: BoxDecoration(
            color: isSelected
                ? (isDark ? const Color(0xFF3A3A3C) : Colors.white)
                : Colors.transparent,
            borderRadius: BorderRadius.circular(7),
            boxShadow: isSelected
                ? [
                    BoxShadow(
                      color: Colors.black.withOpacity(0.08),
                      blurRadius: 4,
                      offset: const Offset(0, 1),
                    )
                  ]
                : null,
          ),
          alignment: Alignment.center,
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Text(
                title,
                style: TextStyle(
                  fontSize: 13,
                  fontWeight: isSelected ? FontWeight.w700 : FontWeight.w500,
                  color: isSelected
                      ? (isDark ? Colors.white : Colors.black)
                      : (isDark ? Colors.white60 : Colors.black54),
                ),
              ),
              if (badge != null) ...[
                const SizedBox(width: 6),
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 5, vertical: 1),
                  decoration: BoxDecoration(
                    color: HonColors.accentOrange,
                    borderRadius: BorderRadius.circular(10),
                  ),
                  child: Text(
                    badge,
                    style: const TextStyle(fontSize: 10, color: Colors.white, fontWeight: FontWeight.bold),
                  ),
                ),
              ],
            ],
          ),
        ),
      ),
    );
  }

  List<Widget> _buildDownloadsTab(
    List<DownloadJob> jobs,
    Color textPrimary,
    Color textSecondary,
    bool isDark,
  ) {
    return [
      // Storage Overview Card
      SliverToBoxAdapter(
        child: Padding(
          padding: const EdgeInsets.fromLTRB(20, 8, 20, 16),
          child: Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: isDark ? HonColors.darkSurface : HonColors.lightSurface,
              borderRadius: BorderRadius.circular(16),
              border: Border.all(
                color: isDark ? HonColors.darkCardBorder : HonColors.lightCardBorder,
                width: 0.5,
              ),
            ),
            child: Row(
              children: [
                Container(
                  width: 40,
                  height: 40,
                  decoration: BoxDecoration(
                    color: HonColors.accentGreen.withOpacity(0.15),
                    borderRadius: BorderRadius.circular(10),
                  ),
                  child: const Icon(
                    CupertinoIcons.device_phone_portrait,
                    color: HonColors.accentGreen,
                    size: 20,
                  ),
                ),
                const SizedBox(width: 14),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        'Offline Reading Storage',
                        style: TextStyle(
                          fontSize: 14,
                          fontWeight: FontWeight.w700,
                          color: textPrimary,
                        ),
                      ),
                      const SizedBox(height: 2),
                      Text(
                        '${jobs.where((j) => j.status == DownloadStatus.completed).length} chapters ready offline in airplane mode.',
                        style: TextStyle(fontSize: 12, color: textSecondary),
                      ),
                    ],
                  ),
                ),
              ],
            ),
          ),
        ),
      ),

      // Jobs List
      if (jobs.isEmpty)
        SliverFillRemaining(
          child: Center(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Icon(
                  CupertinoIcons.arrow_down_circle,
                  size: 56,
                  color: isDark ? Colors.white24 : Colors.black26,
                ),
                const SizedBox(height: 16),
                Text(
                  'No Active Downloads',
                  style: TextStyle(fontSize: 17, fontWeight: FontWeight.w600, color: textPrimary),
                ),
                const SizedBox(height: 6),
                Text(
                  'Novel chapters queued for offline reading appear here.',
                  style: TextStyle(fontSize: 13, color: textSecondary),
                ),
              ],
            ),
          ),
        )
      else
        SliverPadding(
          padding: const EdgeInsets.symmetric(horizontal: 20),
          sliver: SliverList(
            delegate: SliverChildBuilderDelegate(
              (context, index) {
                final job = jobs[index];
                return Padding(
                  padding: const EdgeInsets.only(bottom: 10),
                  child: Container(
                    padding: const EdgeInsets.all(14),
                    decoration: BoxDecoration(
                      color: isDark ? const Color(0xFF1E1E20) : const Color(0xFFF2F2F7),
                      borderRadius: BorderRadius.circular(14),
                      border: Border.all(
                        color: isDark ? Colors.white10 : Colors.black.withOpacity(0.06),
                        width: 0.5,
                      ),
                    ),
                    child: Row(
                      children: [
                        Icon(
                          job.status == DownloadStatus.completed
                              ? CupertinoIcons.check_mark_circled_solid
                              : CupertinoIcons.arrow_down_circle,
                          color: job.status == DownloadStatus.completed
                              ? HonColors.accentGreen
                              : HonColors.accentOrange,
                          size: 24,
                        ),
                        const SizedBox(width: 14),
                        Expanded(
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Text(
                                job.chapterTitle,
                                style: TextStyle(
                                  fontSize: 15,
                                  fontWeight: FontWeight.w600,
                                  color: textPrimary,
                                ),
                              ),
                              const SizedBox(height: 2),
                              Text(
                                job.status == DownloadStatus.completed
                                    ? 'Downloaded & ready offline'
                                    : 'Downloading... ${(job.progress * 100).toInt()}%',
                                style: TextStyle(fontSize: 12, color: textSecondary),
                              ),
                            ],
                          ),
                        ),
                        if (job.status == DownloadStatus.completed)
                          TextButton(
                            child: const Text('Read'),
                            onPressed: () {
                              final book = DatabaseService.instance.getBookById(job.bookId);
                              if (book != null) {
                                ReaderNavigator.openBook(context, book);
                              }
                            },
                          ),
                      ],
                    ),
                  ),
                );
              },
              childCount: jobs.length,
            ),
          ),
        ),
    ];
  }

  List<Widget> _buildUpdatesTab(
    List<Book> libraryBooks,
    Color textPrimary,
    Color textSecondary,
    bool isDark,
  ) {
    // Note: Live upstream chapter updates will be populated when Phase 0C Lua extensions are integrated.
    // We intentionally do not fabricate mock updates.
    final updates = <ChapterUpdateItem>[];

    return [
      if (updates.isEmpty)
        SliverFillRemaining(
          child: Center(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Icon(CupertinoIcons.clock, size: 48, color: textSecondary.withOpacity(0.4)),
                const SizedBox(height: 12),
                Text(
                  'No Chapter Updates',
                  style: TextStyle(fontSize: 16, fontWeight: FontWeight.w600, color: textPrimary),
                ),
                const SizedBox(height: 6),
                Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 32),
                  child: Text(
                    'Chapter update tracking will be activated once novel extensions are connected in Phase 0C.',
                    textAlign: TextAlign.center,
                    style: TextStyle(fontSize: 13, color: textSecondary),
                  ),
                ),
              ],
            ),
          ),
        )
      else
        SliverPadding(
          padding: const EdgeInsets.symmetric(horizontal: 20),
          sliver: SliverList(
            delegate: SliverChildBuilderDelegate(
              (context, index) {
                final item = updates[index];
                return Padding(
                  padding: const EdgeInsets.symmetric(vertical: 6),
                  child: InkWell(
                    onTap: () {
                      if (item.book != null) {
                        ReaderNavigator.openBook(context, item.book!);
                      }
                    },
                    borderRadius: BorderRadius.circular(12),
                    child: Container(
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: isDark ? const Color(0xFF1E1E20) : const Color(0xFFF2F2F7),
                        borderRadius: BorderRadius.circular(12),
                        border: Border.all(
                          color: isDark ? Colors.white10 : Colors.black.withOpacity(0.06),
                          width: 0.5,
                        ),
                      ),
                      child: Row(
                        children: [
                          if (item.book != null)
                            BookCoverWidget(
                              title: item.book!.title,
                              author: item.book!.author,
                              coverPath: item.book!.coverPath,
                              width: 44,
                              height: 62,
                              borderRadius: 4,
                            )
                          else
                            Container(
                              width: 44,
                              height: 62,
                              decoration: BoxDecoration(
                                color: HonColors.accentOrange.withOpacity(0.2),
                                borderRadius: BorderRadius.circular(4),
                              ),
                              child: const Icon(CupertinoIcons.book, size: 20),
                            ),
                          const SizedBox(width: 14),

                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  item.novelTitle,
                                  maxLines: 1,
                                  overflow: TextOverflow.ellipsis,
                                  style: TextStyle(
                                    fontSize: 15,
                                    fontWeight: FontWeight.w600,
                                    color: textPrimary,
                                  ),
                                ),
                                const SizedBox(height: 3),
                                Row(
                                  children: [
                                    Container(
                                      width: 6,
                                      height: 6,
                                      decoration: const BoxDecoration(
                                        color: HonColors.accentBlue,
                                        shape: BoxShape.circle,
                                      ),
                                    ),
                                    const SizedBox(width: 6),
                                    Text(
                                      item.chapterTitle,
                                      style: TextStyle(
                                        fontSize: 13,
                                        color: textSecondary,
                                        fontWeight: FontWeight.w500,
                                      ),
                                    ),
                                  ],
                                ),
                              ],
                            ),
                          ),

                          Icon(
                            item.isDownloaded
                                ? CupertinoIcons.check_mark_circled_solid
                                : CupertinoIcons.arrow_down_circle,
                            color: item.isDownloaded ? HonColors.accentGreen : textSecondary,
                            size: 22,
                          ),
                        ],
                      ),
                    ),
                  ),
                );
              },
              childCount: updates.length,
            ),
          ),
        ),
    ];
  }
}
</file>

<file path="lib/features/home/presentation/widgets/continue_reading_card.dart">
import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import '../../../../core/database/database_service.dart';
import '../../../../core/models/book.dart';
import '../../../../core/models/reading_progress.dart';
import '../../../../shared/widgets/book_cover_widget.dart';
import '../../../reader/presentation/reader_navigator.dart';

class ContinueReadingCard extends StatelessWidget {
  final Book book;
  final ReadingProgress? progress;

  const ContinueReadingCard({
    super.key,
    required this.book,
    this.progress,
  });

  @override
  Widget build(BuildContext context) {
    final pct = progress != null ? (progress!.completionPercentage * 100).toInt() : 0;

    // Card gradient based on book identity
    final hash = book.title.hashCode.abs();
    final gradients = [
      [const Color(0xFF634133), const Color(0xFF8B5A2B)],
      [const Color(0xFF2B4353), const Color(0xFF456268)],
      [const Color(0xFF3B2F4C), const Color(0xFF5D4E6D)],
      [const Color(0xFF2C4A3E), const Color(0xFF43655A)],
      [const Color(0xFF5B323E), const Color(0xFF7A4A58)],
    ];
    final gradient = gradients[hash % gradients.length];

    return GestureDetector(
      onTap: () => ReaderNavigator.openBook(context, book),
      child: Container(
        width: 290,
        height: 120,
        decoration: BoxDecoration(
          borderRadius: BorderRadius.circular(18),
          gradient: LinearGradient(
            colors: gradient,
            begin: Alignment.topLeft,
            end: Alignment.bottomRight,
          ),
          boxShadow: [
            BoxShadow(
              color: gradient[0].withOpacity(0.35),
              blurRadius: 12,
              offset: const Offset(0, 5),
            ),
          ],
        ),
        padding: const EdgeInsets.all(12),
        child: Row(
          children: [
            // Left: Book Cover
            BookCoverWidget(
              title: book.title,
              author: book.author,
              coverPath: book.coverPath,
              width: 64,
              height: 96,
              borderRadius: 6,
            ),
            const SizedBox(width: 14),

            // Middle: Title, Author, Progress
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Text(
                    book.title,
                    maxLines: 2,
                    overflow: TextOverflow.ellipsis,
                    style: const TextStyle(
                      color: Colors.white,
                      fontSize: 16,
                      fontWeight: FontWeight.w700,
                      letterSpacing: -0.2,
                    ),
                  ),
                  const SizedBox(height: 3),
                  Text(
                    book.author,
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                    style: TextStyle(
                      color: Colors.white.withOpacity(0.75),
                      fontSize: 13,
                      fontWeight: FontWeight.w400,
                    ),
                  ),
                  const SizedBox(height: 6),
                  Text(
                    'Book • $pct%',
                    style: TextStyle(
                      color: Colors.white.withOpacity(0.9),
                      fontSize: 12,
                      fontWeight: FontWeight.w500,
                    ),
                  ),
                ],
              ),
            ),

            // Right: Three dots action menu
            Align(
              alignment: Alignment.topRight,
              child: IconButton(
                icon: const Icon(
                  CupertinoIcons.ellipsis,
                  color: Colors.white70,
                  size: 20,
                ),
                padding: EdgeInsets.zero,
                constraints: const BoxConstraints(),
                onPressed: () {
                  _showBookContextMenu(context);
                },
              ),
            ),
          ],
        ),
      ),
    );
  }

  void _showBookContextMenu(BuildContext context) {
    showCupertinoModalPopup(
      context: context,
      builder: (ctx) => CupertinoActionSheet(
        title: Text(book.title),
        message: Text(book.author),
        actions: [
          CupertinoActionSheetAction(
            child: const Text('Read from Last Location'),
            onPressed: () {
              Navigator.of(ctx).pop();
              ReaderNavigator.openBook(context, book);
            },
          ),
          CupertinoActionSheetAction(
            child: const Text('Mark as Finished'),
            onPressed: () {
              DatabaseService.instance.markBookFinished(book.id, true);
              Navigator.of(ctx).pop();
            },
          ),
        ],
        cancelButton: CupertinoActionSheetAction(
          isDefaultAction: true,
          child: const Text('Cancel'),
          onPressed: () => Navigator.of(ctx).pop(),
        ),
      ),
    );
  }
}
</file>

<file path="lib/features/home/presentation/widgets/reading_goals_sheet.dart">
import 'dart:math';
import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import '../../../../app/theme/hon_colors.dart';
import '../../../../app/theme/hon_typography.dart';
import '../../../../core/database/database_service.dart';
import '../../../../core/models/book.dart';
import '../../../reader/presentation/reader_navigator.dart';

class ReadingGoalsSheet extends StatelessWidget {
  final Book? mostRecentBook;

  const ReadingGoalsSheet({
    super.key,
    this.mostRecentBook,
  });

  static Future<void> show(BuildContext context, {Book? mostRecentBook}) {
    return showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (_) => ReadingGoalsSheet(mostRecentBook: mostRecentBook),
    );
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final bgColor = isDark ? const Color(0xFF141416) : Colors.white;
    final textColor = isDark ? Colors.white : Colors.black;
    final subtextColor = isDark ? Colors.white60 : Colors.black54;

    final finishedBooks = DatabaseService.instance.getLibraryBooks().where((b) {
      final prog = DatabaseService.instance.getProgress(b.id);
      return (prog != null && prog.completionPercentage >= 0.99);
    }).toList();

    return Container(
      height: MediaQuery.of(context).size.height * 0.85,
      decoration: BoxDecoration(
        color: bgColor,
        borderRadius: const BorderRadius.vertical(top: Radius.circular(24)),
      ),
      child: Column(
        children: [
          // Drag indicator
          Container(
            margin: const EdgeInsets.only(top: 10, bottom: 8),
            width: 36,
            height: 4,
            decoration: BoxDecoration(
              color: isDark ? Colors.white24 : Colors.black26,
              borderRadius: BorderRadius.circular(2),
            ),
          ),

          // Close button bar
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 16),
            child: Align(
              alignment: Alignment.topRight,
              child: IconButton(
                icon: Icon(CupertinoIcons.xmark_circle_fill, color: isDark ? Colors.white38 : Colors.black38),
                onPressed: () => Navigator.of(context).pop(),
              ),
            ),
          ),

          Expanded(
            child: SingleChildScrollView(
              physics: const BouncingScrollPhysics(),
              padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 8),
              child: Column(
                children: [
                  Text(
                    'Reading Goals',
                    style: HonTypography.largeTitle(color: textColor).copyWith(fontSize: 26),
                  ),
                  const SizedBox(height: 6),
                  Text(
                    'Read every day, see your stats soar and\nfinish more books.',
                    textAlign: TextAlign.center,
                    style: TextStyle(fontSize: 14, color: subtextColor, height: 1.35),
                  ),
                  const SizedBox(height: 32),

                  // Half-circle arc gauge matching Apple Books screenshot
                  Builder(
                    builder: (context) {
                      final todayMins = DatabaseService.instance.getTodayReadingMinutes();
                      final goalMins = DatabaseService.instance.getDailyGoalMinutes();
                      final fraction = goalMins > 0 ? (todayMins / goalMins).clamp(0.0, 1.0) : 0.0;

                      return SizedBox(
                        width: 240,
                        height: 125,
                        child: CustomPaint(
                          painter: _ArcGaugePainter(
                            progress: fraction > 0 ? fraction : 0.02,
                            color: fraction >= 1.0 ? HonColors.accentGreen : HonColors.accentBlue,
                            trackColor: isDark ? const Color(0xFF2C2C2E) : const Color(0xFFE5E5EA),
                          ),
                          child: Column(
                            mainAxisAlignment: MainAxisAlignment.end,
                            children: [
                              Text(
                                'Today\'s Reading',
                                style: TextStyle(
                                  fontSize: 13,
                                  fontWeight: FontWeight.w600,
                                  color: textColor,
                                ),
                              ),
                              const SizedBox(height: 4),
                              Text(
                                '$todayMins:00',
                                style: TextStyle(
                                  fontSize: 38,
                                  fontWeight: FontWeight.w800,
                                  fontFamily: 'serif',
                                  color: textColor,
                                  letterSpacing: -1,
                                ),
                              ),
                              Text(
                                'of your $goalMins-minute goal >',
                                style: TextStyle(
                                  fontSize: 12,
                                  color: subtextColor,
                                ),
                              ),
                            ],
                          ),
                        ),
                      );
                    },
                  ),

                  const SizedBox(height: 36),

                  // Keep Reading Button
                  if (mostRecentBook != null)
                    GestureDetector(
                      onTap: () {
                        Navigator.of(context).pop();
                        ReaderNavigator.openBook(context, mostRecentBook!);
                      },
                      child: Container(
                        width: double.infinity,
                        padding: const EdgeInsets.symmetric(vertical: 14),
                        decoration: BoxDecoration(
                          color: isDark ? const Color(0xFF2C2C2E) : const Color(0xFFE5E5EA),
                          borderRadius: BorderRadius.circular(24),
                        ),
                        child: Column(
                          children: [
                            Text(
                              'Keep Reading',
                              style: TextStyle(
                                fontSize: 15,
                                fontWeight: FontWeight.w700,
                                color: textColor,
                              ),
                            ),
                            const SizedBox(height: 2),
                            Text(
                              mostRecentBook!.title,
                              maxLines: 1,
                              overflow: TextOverflow.ellipsis,
                              style: TextStyle(
                                fontSize: 12,
                                color: subtextColor,
                              ),
                            ),
                          ],
                        ),
                      ),
                    ),

                  const SizedBox(height: 40),

                  // Books Read This Year Section
                  Align(
                    alignment: Alignment.centerLeft,
                    child: Text(
                      'Books Read This Year',
                      style: HonTypography.sectionHeader(color: textColor).copyWith(fontSize: 19),
                    ),
                  ),
                  const SizedBox(height: 16),

                  SizedBox(
                    height: 140,
                    child: ListView.separated(
                      scrollDirection: Axis.horizontal,
                      itemCount: max(3, finishedBooks.length + 1),
                      separatorBuilder: (_, __) => const SizedBox(width: 12),
                      itemBuilder: (context, index) {
                        final book = index < finishedBooks.length ? finishedBooks[index] : null;
                        return Container(
                          width: 90,
                          decoration: BoxDecoration(
                            color: isDark ? const Color(0xFF242426) : const Color(0xFFF2F2F7),
                            borderRadius: BorderRadius.circular(10),
                            border: Border.all(
                              color: isDark ? Colors.white10 : Colors.black12,
                              width: 0.5,
                            ),
                          ),
                          alignment: Alignment.center,
                          child: book != null
                              ? Padding(
                                  padding: const EdgeInsets.all(8),
                                  child: Text(
                                    book.title,
                                    textAlign: TextAlign.center,
                                    maxLines: 4,
                                    overflow: TextOverflow.ellipsis,
                                    style: TextStyle(
                                      fontSize: 11,
                                      fontWeight: FontWeight.w600,
                                      color: textColor,
                                    ),
                                  ),
                                )
                              : Text(
                                  '${index + 1}',
                                  style: TextStyle(
                                    fontSize: 32,
                                    fontFamily: 'serif',
                                    fontWeight: FontWeight.w600,
                                    color: isDark ? Colors.white24 : Colors.black26,
                                  ),
                                ),
                        );
                      },
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }
}

class _ArcGaugePainter extends CustomPainter {
  final double progress;
  final Color color;
  final Color trackColor;

  _ArcGaugePainter({
    required this.progress,
    required this.color,
    required this.trackColor,
  });

  @override
  void paint(Canvas canvas, Size size) {
    final center = Offset(size.width / 2, size.height);
    final radius = size.width / 2 - 8;

    final trackPaint = Paint()
      ..color = trackColor
      ..style = PaintingStyle.stroke
      ..strokeWidth = 3.5
      ..strokeCap = StrokeCap.round;

    final progressPaint = Paint()
      ..color = color
      ..style = PaintingStyle.stroke
      ..strokeWidth = 3.5
      ..strokeCap = StrokeCap.round;

    // Draw background semicircle
    canvas.drawArc(
      Rect.fromCircle(center: center, radius: radius),
      pi,
      pi,
      false,
      trackPaint,
    );

    // Draw active arc
    if (progress > 0) {
      canvas.drawArc(
        Rect.fromCircle(center: center, radius: radius),
        pi,
        pi * progress.clamp(0.0, 1.0),
        false,
        progressPaint,
      );
    }
  }

  @override
  bool shouldRepaint(covariant _ArcGaugePainter oldDelegate) =>
      oldDelegate.progress != progress || oldDelegate.color != color;
}
