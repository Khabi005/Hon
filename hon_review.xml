    return TextStyle(
      fontSize: 16,
      fontWeight: FontWeight.w400,
      letterSpacing: -0.2,
      color: color,
    );
  }

  // Reader body text (Jane Austen paragraph style)
  static TextStyle readerBody({
    Color? color,
    double fontSize = 18.0,
    double lineHeight = 1.65,
    String? fontFamily,
  }) {
    switch (fontFamily) {
      case 'New York':
